# Environment Settings
NODE_ENV=development
PORT=10000

# Persistence Datastores
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/insightops?retryWrites=true&w=majority
REDIS_URL=https://your-upstash-redis.upstash.io
REDIS_TOKEN=your-upstash-redis-rest-token

# Security Cryptography
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_chars_long
GOOGLE_CLIENT_ID=google-client-id-for-oauth
GOOGLE_CLIENT_SECRET=google-client-secret-for-oauth
FRONTEND_URL=http://localhost:3000

# Artificial Intelligence Integrations
AI_API_KEY=gsk_your_groq_or_gemini_api_key
