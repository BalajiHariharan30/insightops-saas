# InsightOps Frontend Environment Variables
# Copy this file to .env and fill in the values

# Backend API base URL (include /api/v1)
VITE_API_BASE_URL=http://localhost:10000/api/v1

# Backend Socket.io server URL (no path)
VITE_SOCKET_URL=http://localhost:10000

# Stripe publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
